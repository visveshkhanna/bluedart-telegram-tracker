# Copy to .dev.vars (local dev) or .prod.vars (production); both are gitignored.
# Use a separate bot for each, since a bot can only have one webhook.

# Bot token from @BotFather
BOT_TOKEN="123456:ABC-your-botfather-token"
# Any long random string, e.g. the output of: openssl rand -hex 32
WEBHOOK_SECRET="replace-with-a-long-random-string"
