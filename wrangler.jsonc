{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bluedart-telegram-tracker",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-01",
	"observability": {
		"enabled": true,
	},
	// Ticks every 5 minutes; each shipment is only checked when its own interval
	// (default 1 hour, changeable from the bot) says it's due.
	"triggers": {
		"crons": ["*/5 * * * *"],
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bluedart-tracker",
			"database_id": "f0bef9b9-ab1a-4c0f-a219-52299e8e41e2",
			"migrations_dir": "migrations",
		},
	],
}
