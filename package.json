{
	"name": "bluedart-telegram-tracker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "npm run db:migrate:remote && wrangler deploy",
		"dev": "wrangler dev --test-scheduled",
		"start": "wrangler dev --test-scheduled",
		"test": "vitest run",
		"cf-typegen": "wrangler types --env-file .dev.vars.example",
		"webhook": "node scripts/webhook.mjs",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test",
		"check": "npm run format:check && npm run typecheck && npm test && wrangler deploy --dry-run",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"secrets:prod": "wrangler secret bulk .prod.vars",
		"webhook:prod": "node --env-file=.prod.vars scripts/webhook.mjs",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"postinstall": "npm run cf-typegen"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.3",
		"typescript": "^5.5.2",
		"vitest": "~5.0.3",
		"wrangler": "^4",
		"prettier": "3.9.10"
	},
	"dependencies": {
		"grammy": "^1.46.0",
		"node-html-parser": "9.0.5"
	},
	"cloudflare": {
		"bindings": {
			"BOT_TOKEN": {
				"description": "Your bot's token from [@BotFather](https://t.me/BotFather) (send `/newbot`)."
			},
			"WEBHOOK_SECRET": {
				"description": "Any long random string (e.g. `openssl rand -hex 32`). Telegram sends it with every update so the Worker can verify requests. You'll also use it once to open `/setup?secret=…`."
			},
			"DB": {
				"description": "D1 database that stores users, shipments and scan history."
			}
		}
	}
}
