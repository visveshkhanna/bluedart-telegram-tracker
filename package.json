{
	"name": "bluedart-telegram-tracker",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev --test-scheduled",
		"start": "wrangler dev --test-scheduled",
		"test": "vitest run",
		"cf-typegen": "wrangler types",
		"webhook": "node scripts/webhook.mjs",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p test",
		"check": "npm run typecheck && npm test && wrangler deploy --dry-run",
		"db:migrate:local": "wrangler d1 migrations apply bluedart-tracker --local",
		"db:migrate:remote": "wrangler d1 migrations apply bluedart-tracker --remote",
		"secrets:prod": "wrangler secret bulk .prod.vars",
		"webhook:prod": "node --env-file=.prod.vars scripts/webhook.mjs"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.4.3",
		"typescript": "^5.5.2",
		"vitest": "~5.0.3",
		"wrangler": "^4"
	},
	"dependencies": {
		"grammy": "^1.46.0",
		"node-html-parser": "9.0.5"
	}
}
